<Window x:Class="PLCConnectFramework.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PLCConnectFramework.App"
        mc:Ignorable="d"
        Title="PLC Connect Framework" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="PLC Connect Framework" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="This is a skeleton application for PLC connectivity. The focus is on the library framework." 
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
        </StackPanel>
        
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="10">
            <ScrollViewer>
                <StackPanel Margin="10">
                    <TextBlock Text="Available PLC Types:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ListBox x:Name="PlcTypesList" Height="100" Margin="0,0,0,10"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC Name:" Margin="0,0,10,5" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="PlcNameTextBox" Margin="0,0,0,5"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="IP Address:" Margin="0,0,10,5" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="IpAddressTextBox" Margin="0,0,0,5"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Port:" Margin="0,0,10,5" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="PortTextBox" Margin="0,0,0,5"/>
                        
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="ConnectButton" Content="Connect" Width="100" Margin="0,0,10,0" Click="ConnectButton_Click"/>
                            <Button x:Name="DisconnectButton" Content="Disconnect" Width="100" IsEnabled="False" Click="DisconnectButton_Click"/>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="Connection Status:" FontWeight="Bold" Margin="0,20,0,5"/>
                    <TextBlock x:Name="ConnectionStatusTextBlock" Text="Not connected" Margin="0,0,0,10"/>
                    
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Read/Write Operations:" FontWeight="Bold" Margin="0,0,0,10"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Address:" Margin="0,0,10,5" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="AddressTextBox" Margin="0,0,10,5"/>
                                <Button Grid.Row="0" Grid.Column="2" x:Name="ReadButton" Content="Read" Width="80" IsEnabled="False" Click="ReadButton_Click"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Value:" Margin="0,0,10,5" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ValueTextBox" Margin="0,0,10,5"/>
                                <Button Grid.Row="1" Grid.Column="2" x:Name="WriteButton" Content="Write" Width="80" IsEnabled="False" Click="WriteButton_Click"/>
                            </Grid>
                            
                            <TextBlock Text="Result:" FontWeight="Bold" Margin="0,10,0,5"/>
                            <TextBox x:Name="ResultTextBox" Height="100" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
